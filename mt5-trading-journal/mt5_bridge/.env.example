# Copy this file to .env and fill in your values.
# Leave MT5_ACCOUNT=0 to use whichever account is already logged into the terminal.

MT5_ACCOUNT=0
MT5_PASSWORD=
MT5_SERVER=
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# URL of the journal backend (localhost if running on same machine via Docker)
API_URL=http://localhost:8000

# How often to poll MT5 (seconds)
POLL_INTERVAL=15

# How many days of history to pull on the very first run
HISTORY_DAYS=90

LOG_FILE=bridge.log
